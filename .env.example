# ── Render engine (Node API) ─────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Run every render in mock mode (no paid APIs). Per-request {"mock": true} also works.
RENDER_MOCK=false
# Python interpreter for the pipeline steps. Defaults to ./.venv/bin/python, then python3.
# PYTHON_BIN=/absolute/path/to/python

# ── Anthropic (scene split + image prompts via the script-reviewer skill) ─────
ANTHROPIC_API_KEY=
# CLASSIFY_MODEL=claude-opus-4-8

# ── ElevenLabs (narration) ───────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# Default voice id (fallback for any voice name not mapped below).
ELEVENLABS_VOICE_ID=
# Per-voice ids: request {"voice":"adam"} → VOICE_ADAM_ID, etc.
VOICE_ADAM_ID=
# VOICE_RACHEL_ID=
# ELEVENLABS_SPEED=1.0
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.85
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_192
# ELEVENLABS_SEED=12345
# AUDIO_TAIL_PAD=0.3

# ── Replicate (scene images, flux-schnell) ───────────────────────────────────
REPLICATE_API_TOKEN=
# FLUX_MODEL=black-forest-labs/flux-schnell
